{
  "name": "agents-everywhere-starter-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starter kit for the Agents, Everywhere: Bots, Channels & More global hackathon.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/channel-slack",
    "apps/local-chat",
    "apps/web",
    "apps/mcp",
    "apps/durable"
  ],
  "scripts": {
    "check-env": "bash scripts/check-env.sh",
    "predev": "bash scripts/check-env.sh",
    "dev": "bash scripts/dev.sh",
    "dev:slack": "npm run dev --workspace channel-slack",
    "channel:status": "npx copilotkit@latest channels status --json",
    "channel:setup": "npx copilotkit@latest channels setup",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:local": "npm run dev --workspace local-chat",
    "dev:web": "npm run dev --workspace web",
    "dev:mcp": "npm run dev --workspace mcp",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "vitest",
    "verify": "bash scripts/verify.sh"
  },
  "overrides": {
    "@ag-ui/client": "0.0.59"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
