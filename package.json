{
  "name": "agents-everywhere-starter-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starter kit for the Agents, Everywhere: Bots, Channels & More global hackathon.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/channel",
    "apps/web",
    "apps/api",
    "apps/procure-agent",
    "apps/erp-frontend"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:slack": "npm run dev --workspace channel",
    "channel:status": "npx copilotkit@latest channels status --json",
    "channel:setup": "npx copilotkit@latest channels setup",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev --workspace web",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run typecheck && npm test",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "npm run migrate --workspace procure-db",
    "db:seed": "npm run seed --workspace procure-db",
    "test:db": "npm run test:db --workspaces --if-present",
    "dev:api": "npm run dev --workspace procure-api",
    "dev:agent": "npm run dev --workspace procure-agent",
    "dev:erp": "npm run dev --workspace erp-frontend"
  },
  "overrides": {
    "@ag-ui/client": "0.0.59"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
