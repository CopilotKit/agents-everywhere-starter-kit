# Copy to .env in this directory. Use Node.js 22+.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3003
# Public HTTPS origin from your tunnel, with no path. Must match both dashboards.
PUBLIC_BASE_URL=https://your-tunnel.example
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Identifier of your Auth0 custom API, with the create:requests permission.
AUTH0_AUDIENCE=https://whatsapp-demo.example
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use the exact sender displayed in your own Twilio Sandbox / testing environment.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional absolute path; default is this app's .data/state.json. Run one process only.
# DATA_FILE=/absolute/path/whatsapp-state.json
