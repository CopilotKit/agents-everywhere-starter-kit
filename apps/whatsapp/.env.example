# Copy to .env in this directory. Use Node.js 22+. No Twilio account is used.
# Choose openai or openrouter explicitly. Only the selected provider's key is required.
MODEL_PROVIDER=openai
MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# OpenRouter example: MODEL_PROVIDER=openrouter and MODEL=openai/gpt-4.1-mini.
# MODEL takes precedence over legacy OPENAI_MODEL, which is still supported.
# OpenRouter models/endpoints must support strict JSON schema structured output.
# Tunnel ONLY the main app port. Keep the SDK listener private.
PORT=3003
WHATSAPP_WEBHOOK_PORT=3004
PUBLIC_BASE_URL=https://your-tunnel.example
# Meta WhatsApp Cloud API: use the Phone Number ID, not the displayed phone number.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Choose your own random verification token; put the same value in Meta Webhooks.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
# CopilotRuntime owns the direct adapter lifecycle through Intelligence.
WHATSAPP_CHANNEL_NAME=whatsapp-demo
INTELLIGENCE_API_KEY=
# Auth0 confidential Regular Web Application with Authorization Code + CIBA grants.
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Identifier of your RS256 Auth0 API with the create:requests permission.
AUTH0_AUDIENCE=https://whatsapp-demo.example
# Optional absolute path; default is this app's .data/state.json. One process only.
# Use a NEW file when migrating old Twilio state; authenticate and LINK again.
# DATA_FILE=/absolute/path/whatsapp-meta-state.json
